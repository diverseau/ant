# Environment variables antd reads. All optional; the defaults suit one person on one computer.
# antd doesn't load this file itself: export them, set them in the systemd unit, or use them
# with docker compose (`env_file`). Never put Claude credentials here; sign in with `claude` → /login.

# Where things live
# ANT_HOME=~/Ants                       # ants' folders
# ANT_DATA_DIR=~/.local/share/ant       # database, generated settings, vault key, logos cache
# ANT_DB=$ANT_DATA_DIR/ant.db
# ANT_SOCKET=$ANT_DATA_DIR/antd.sock    # ant ↔ antd IPC

# Server
# ANT_HOST=127.0.0.1                    # 0.0.0.0 only behind https (Docker sets it)
# ANT_PORT=7420
# ANT_WEB_PORTS=5173,5180,5181          # dev UI ports ants must never reach

# Remote access (see docs/self-hosting.md)
# ANT_ALLOWED_HOSTS=ant.example.ts.net  # extra host names; Settings → Devices adds the Tailscale one
# ANT_PUBLIC_URL=https://ant.example.ts.net:8443   # for pairing links and push
# ANT_REQUIRE_LOGIN=1                   # make this computer pair too

# Ants
# ANT_MODEL=sonnet                      # default model for new ants (settings override it)
# ANT_MAX_BUSY=3                        # ants working at once
# ANT_IDLE_MS=600000                    # stop an idle ant's process after this long
# ANT_USER_NAME=Alex

# Tools antd runs
# ANT_CLAUDE_BIN=claude
# ANT_TAILSCALE_BIN=tailscale
# ANT_VOXTYPE_BIN=voxtype               # dictation
# ANT_FFMPEG_BIN=ffmpeg                 # dictation

# Misc
# ANT_NO_DESKTOP_NOTIFY=1               # no notify-send popups
# ANT_IN_CONTAINER=1                    # set by the Docker image
